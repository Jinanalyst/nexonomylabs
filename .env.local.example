# Copy this file to .env.local and fill in your Supabase project values.
# Find them in your Supabase dashboard → Project Settings → API.
# Without these, the app runs in demo mode (seed data, no auth).

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: enables the "Fetch latest news" button in /admin, which pulls
# real articles (with images) from Finnhub's free news API. Get a free key
# (no credit card) at https://finnhub.io/register — this is a server-only
# secret, never exposed to the browser, so it does NOT use NEXT_PUBLIC_.
FINNHUB_API_KEY=your-finnhub-api-key

# Optional: secret that protects /api/cron/ingest-news from being triggered
# by anyone who finds the URL. Required only if you set up automated news
# refresh (see README). Any random string works — generate one with
# `openssl rand -hex 32` or similar.
CRON_SECRET=your-random-secret
